# ═══════════════════════════════════════════════════════
#  GAIA Protocol — Unified .gitignore
# ═══════════════════════════════════════════════════════

# ── Dependencies ────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Build Output ────────────────────────────────────────
dist/
build/
.next/
out/

# ── Environment Variables ───────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
*.sqlite3
media/

# ── Flutter / Dart ──────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# ── IDE / Editor ────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS Files ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Lock Files (managed per-app) ────────────────────────
*.lock
!package-lock.json

# ── Misc / Scratch ──────────────────────────────────────
.activity_tracker.md
.todo.md